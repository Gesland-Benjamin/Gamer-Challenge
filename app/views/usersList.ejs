<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>

<main>
  <h1> Salle de controle des Bans </h1>
  <h2>Liste des utilisateurs</h2>

  <div class="user-list">
    <% if (users && users.length> 0) { %>
      <% users.forEach(user=> { %>

      <div class="user-list__card">
        <h3><%= user.username %></h3>
               
        <p>Status :
          <% if (user.isBanned) { %>
            <span class="user-list__banned">Banni</span>
            <% } else { %><span class="user-list__active">Actif</span><% } %>
        </p>

        <% if (!user.isBanned) { %>
          <form action="/admin/ban/<%= user.id %>" method="POST">
            <button type="submit" class="user-list__ban-button">Bannir</button>
          </form>

        <% } else { %>
          <form action="/admin/unban/<%= user.id %>" method="POST">
            <button type="submit" class="user-list__unban-button">Débannir</button>
          </form>
        <% } %>
    </div>
    <% }); %>

    <% } else { %>
      <p>Aucun utilisateur trouvé.</p>
    <% } %>
  </div>
</main>

<%- include('./partials/footer') %>