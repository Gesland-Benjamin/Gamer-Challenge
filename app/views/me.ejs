<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<section >
    <h1>Mon compte</h1>
    <p> 
        Bienvenue sur votre page de profil, <%= user.username %> !
        Ici, vous pouvez gérer vos informations personnelles, consulter vos participations aux défis et suivre
        vos progrès dans la communauté GamerChallenges.
    </p>
    <form action="/me" method="post">
        <legend>Mon compte</legend>
        <fieldset>
            <div >
                <label for="username">Pseudo</label>
                <input type="text" name="username" >
                <i ></i>
            </div>
            <div >
                <label for="mail">Adresse mail</label>
                <input type="email" name="mail" >
                <i ></i>
            </div>
            <div class="field_form_container">
                <label for="password">Mot de passe</label>
                <input type="password" name="password" >
                <i ></i>
            </div>
            <div class="field_form_container">
                <label for="favoriteGame">Jeu préféré</label>
                <input type="text" name="favoriteGame" >
                <i ></i>
            </div>
            <div class="socials">
                <label for="">Réseaux sociaux</label>
                <div class="socials_form_container">
                    <div class="field_form_container">
                        <input type="url" name="x"  placeholder="https://x.com/votrepseudo" value="<%= user.socials ? user.socials.twitter : '' %>">
                        <i ></i>
                    </div>
                    <div class="field_form_container">
                        <input type="url" name="instagram"  placeholder="https://instagram.com/votrepseudo" value="<%= user.socials ? user.socials.instagram : '' %>">
                        <i ></i>
                    </div>
                    <div class="field_form_container">
                        <input type="url" name="twitch"  placeholder="https://twitch.tv/votrepseudo" value="<%= user.socials ? user.socials.twitch : '' %>">
                        <i ></i>
                    </div>
                    <div class="field_form_container">
                        <input type="url" name="youtube"  placeholder="https://youtube.com/votrepseudo" value="<%= user.socials ? user.socials.youtube : '' %>">
                        <i ></i>
                    </div>
                    <div class="field_form_container">
                        <input type="text" name="discord"  placeholder="Votre pseudo Discord#1234" value="<%= user.socials ? user.socials.discord : '' %>">
                        <i ></i>
                    </div>
                </div>
            </div>
            <button type="submit" >Modifier mes informations</button>
        </fieldset>
    </form>
    <button>Retour à l'accueil</button>
</section>

<%- include('partials/footer') %>