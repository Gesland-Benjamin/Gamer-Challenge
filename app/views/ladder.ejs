<%- include('partials/header.ejs') %> <%- include('./partials/aside_nav') %>

<main class="classement-container">
  <div class="classement-header">
    <img
      src="/logos/logo-classement.png"
      alt="Bannière classement"
      class="classement-logo"
    />
    <h1 class="classement-title">CLASSEMENT</h1>
  </div>

  <div class="top-bar-ladder"></div>
  <section id="main__podium">
    <h2 class="classement-subtitle">TOP 3 DES MEILLEURS GAMERS</h2>

    <div class="podium">
  <% users.slice(0, 3).forEach((user, index) => { %>
    <a href="/profile/<%= user.id %>" class="podium-link">
      <article class="podium-card <% if(index === 0){ %>first<% } %>">
        <div class="podium-img-wrapper">
          <img src="<%= user.picture %>" alt="Profil de <%= user.username %>" />
        </div>
        <h3 class="podium-username"><%= user.username %></h3>
        <p class="podium-score">
          <%= user.voteCount %> <span class="heart">❤️</span>
        </p>
      </article>
    </a>
  <% }) %>
</div>


    <p class="podium-congrats">
      BRAVO ! <% users.slice(0,3).forEach((user, index) => { %> <%=
      user.username %> <% if(index < 2){ %>, <% } %> <% }) %> qui sont nos 3
      meilleurs gamers ! Pour le moment !
    </p>

    <div class="center-btn">
      <a href="/challenges" class="button">RETOUR CHALLENGES</a>
    </div>
  </section>
</main>

<%- include('partials/footer.ejs') %>
