<%- include('./partials/header') %>
<%- include('./partials/aside_nav') %>

<section class="add_form">

  <div class="forms_container">
    <form action="/admin/addgame" method="POST" class="form_register">
      <legend>ADD GAME</legend>
      <fieldset>

        <div class="form_content_container">
          <input type="text" placeholder="name" name="name" class="form_input">
        </div>

        <div class="form_content_container">
          <textarea placeholder="Description" name="description" class="form_input"></textarea>
        </div>

        <div class="form_content_container">
          <input type="date" placeholder="Release Year" name="release_year" class="form_input" >
        </div>

        <div class="form_content_container">
          <input type="text" placeholder="Genre" name="genre" class="form_input">
        </div>

        <div class="form_content_container">
          <label for="picture" class="form_label">Game Picture</label>
          <input type="file" id="picture" name="picture" accept="image/*" class="form_input">
        </div>

        <button type="submit" class="btn_submit">Valider</button>

      </fieldset>
    </form>

    <a href="/" class="back_link">Retour à l'accueil</a>
  </div>

</section>

<%- include('./partials/footer') %>
