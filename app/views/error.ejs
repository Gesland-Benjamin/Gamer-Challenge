<main>
      <section style="text-align:center; margin: 8rem 0; color: blue;">
        <h1>Oups, une erreur est survenue !</h1>

        <p>
          Nous sommes désolés, une erreur inattendue s'est produite.<br>
          Merci de réessayer plus tard.
        </p>

        <% if (typeof message !== "undefined") { %>
          <p><strong>Erreur <%= errorCode %></strong></p>
          <p><%= message %></p>
        <% } %>

        <a class="button" href="/">Retour à l'accueil</a>
      </section>
    </main>