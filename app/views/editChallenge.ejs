<%- include('./partials/header') %>
    <%- include('./partials/aside_nav') %>

        <section class="add_form">

            <div class="forms_container">
                <form action="/challenges/<%= challenge.id %>/edit" method="POST" class="form_register">
                    <legend>Modifier un challenge</legend>
                    <fieldset>

                        <div class="form_content_container">
                            <input type="text" placeholder="name" name="name" class="form_input">
                        </div>

                        <div class="form_content_container">
                            <textarea placeholder="Description" name="description" class="form_input"></textarea>
                        </div>

                        <div class="form_content_container">
                            <input type="date" placeholder="Release Date" name="release_date" class="form_input">
                        </div>

                        <form action="/challenges/<%= challenge.id %>/edit" method="POST">
                            <button type="submit">Valider</button>
                        </form>

                    </fieldset>
                </form>

                <a href="/" class="back_link">Retour à l'accueil</a>
            </div>

        </section>

        <%- include('./partials/footer') %>