<%- include('partials/header') %>

<main>

  <%- include('partials/aside_nav') %>


  <div class="games__top-title-wrapper">
    <span class="games__top-title">JEUX</span>
    <div class="games__top-bar"></div>
  </div>

  <!-- JEUX -->
  <ul class="list">
    <% if (listGames && listGames.length) { %>
      <% listGames.forEach(game => { %>
        <li class="list__game">
          <a class="game__a" href="/games/<%= game.id %>">
            <img src="<%= game.picture %>" alt="<%= game.name %>" class="game-cover" />
            <h2 id="game<%= game.id %>-name" class="game-name"><%= game.name %></h2>
          </a>
        </li>
      <% }) %>

    <% } else { %>
      <li class="list__error-message">Aucun jeu disponible.</li>
    <% } %>
  </ul>

  <!-- PAGINATION -->
  <div class="pagination">
    <% if (totalPages > 1) { %>
      <% for (let i = 1; i <= totalPages; i++) { %>
        
        <% if (i === page) { %>
          <span class="pagination__span"><%= i %></span>
        <% } else { %>
          <a href="/games?page=<%= i %>" class="pagination__a"><%= i %></a>
        <% } %>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>