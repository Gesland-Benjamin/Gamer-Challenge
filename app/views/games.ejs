<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<ul>
  <% if (listGames && listGames.length) { %>
    <% listGames.forEach(game => { %>
      <li>
        <img src="/images/<%= game.picture %>" alt="<%= game.name %>" class="game-cover" />
      </li>
    <% }) %>
  <% } else { %>
    <li>Aucun jeu disponible.</li>
  <% } %>
</ul>

<a href='/' class="button">Accueil</a>

<%- include('partials/footer') %>