<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<form action="/me/password" method="POST" novalidate>
  <!-- Si formulaire de modification : ne pré-remplis pas le mot de passe -->
  <div class="form-row">
    <label for="currentPassword">Mot de passe actuel</label>
    <div class="pw-wrapper">
      <input type="password" id="currentPassword" name="currentPassword" placeholder="Entrez votre mot de passe actuel" autocomplete="current-password">
      <button type="button"
              class="pw-toggle"
              data-target="currentPassword"
              aria-pressed="false"
              aria-label="Afficher le mot de passe actuel">
        👁
      </button>
    </div>
  </div>

  <div class="form-row">
    <label for="newPassword">Nouveau mot de passe</label>
    <div class="pw-wrapper">
      <input type="password" id="newPassword" name="newPassword" placeholder="Entrez un nouveau mot de passe" autocomplete="new-password">
      <button type="button"
              class="pw-toggle"
              data-target="newPassword"
              aria-pressed="false"
              aria-label="Afficher le nouveau mot de passe">
        👁
      </button>
    </div>
  </div>

  <div class="form-row">
    <label for="confirmPassword">Confirmer le nouveau mot de passe</label>
    <div class="pw-wrapper">
      <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirmez le nouveau mot de passe" autocomplete="new-password">
      <button type="button"
              class="pw-toggle"
              data-target="confirmPassword"
              aria-pressed="false"
              aria-label="Afficher la confirmation du mot de passe">
        👁
      </button>
    </div>
  </div>

  <button type="submit">Mettre à jour</button>
</form>

<%- include('partials/footer') %>
<script src="/js/password.js"></script>

