<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<main id="contact-page">
  <div class="forms-container">
    <div>
      <h2 class="form-legend">Modifier mon mot de passe</h2>
      <form action="/me/password" method="POST" novalidate>
        <label for="currentPassword">Mot de passe actuel</label>
        <div class="input-with-icon">
          <input class="input" type="password" id="currentPassword" name="currentPassword" placeholder="Entrez votre mot de passe actuel" autocomplete="current-password">
          <button type="button"
                  class="button"
                  data-target="currentPassword"
                  aria-pressed="false"
                  aria-label="Afficher le mot de passe actuel">
            👁
          </button>
        </div>

        <label for="newPassword">Nouveau mot de passe</label>
        <div class="input-with-icon">
          <input class="input" type="password" id="newPassword" name="newPassword" placeholder="Entrez un nouveau mot de passe" autocomplete="new-password">
          <button type="button"
                  class="button"
                  data-target="newPassword"
                  aria-pressed="false"
                  aria-label="Afficher le nouveau mot de passe">
            👁
          </button>
        </div>

        <label for="confirmPassword">Confirmer le nouveau mot de passe</label>
        <div class="input-with-icon">
          <input class="input" type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirmez le nouveau mot de passe" autocomplete="new-password">
          <button type="button"
                  class="button"
                  data-target="confirmPassword"
                  aria-pressed="false"
                  aria-label="Afficher la confirmation du mot de passe">
            👁
          </button>
        </div>

        <button class="myButton-form" type="submit">Mettre à jour</button>
      </form>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/password.js"></script>
