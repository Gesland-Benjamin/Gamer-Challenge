<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<main class="game-page-main" role="main">
  
  <!-- SECTION HEADER DU JEU -->
  <section class="game-header" aria-label="Présentation du jeu">
  <div class="game-cover-wrapper">
    <img src="<%= game.picture %>" alt="<%= game.name %>" class="game-cover" />
  </div>

  <div class="game-info">
    <h2 id="game-name" class="game-name"><%= game.name %></h2>
    <p class="game-description"><%= game.description %></p>
    <p class="game-date"><%= game.release_year.getFullYear() %></p>
    <p class="game-meta"><%= game.genre %></p>
  </div>
</section>

  <hr class="divider" />

  <!-- SECTION DES CHALLENGES -->
  <section class="challenges-section">
    <h2 class="challenges-title">CHALLENGES</h2>

    <% if (game.challenges && game.challenges.length) { %>
      <div class="challenges-list">
        <% game.challenges.forEach(function(challenge) { %>
          <div class="challenge">
            <a href="/challenges/<%= challenge.id %>"><%= challenge.name %></a>
            <div class="challenge-likes">
              <span id="votes-<%= challenge.id %>" class="vote-count">
                <%= challenge.dataValues.voteCount %>
              </span>
              <button class="like-btn" data-id="<%= challenge.id %>">
                ❤️
              </button>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <p class="no-challenges">Aucun challenge disponible.</p>
    <% } %>
  </section>

  <!-- SECTION ACTIONS -->
  <div class="game-actions">
    <% if (user && user.role === 'admin') { %>
      <a href="/games/<%= game.id %>/edit" class="button">Modifier</a>
      <form action="/games/<%= game.id %>/delete" method="POST" style="display:inline;">
        <button type="submit" class="button">Supprimer</button>
      </form>
    <% } %>
    <a href='/challenges/<%= game.id %>/addChallenge' class="button">Ajouter un challenge</a>
    <a href='/' class="button">Accueil</a>
  </div>
</main>

<%- include('partials/footer') %>
<script src="/js/like.js"></script>