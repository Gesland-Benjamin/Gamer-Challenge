<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<main  role="main">
  <section  aria-label="Présentation du jeu">
    <div 
      <img src="/images/<%= game.picture %>" alt="<%= game.name %>"  />
    </div>

    <div >
      <h2 id="game-name" class="game-name"><%= game.name %></h2>

      <p >
        <%= game.description %>
      </p>

      <p >
        <%= game.release_year.getFullYear() %>
      </p>

      <p  aria-hidden="false">
        <%= game.genre %>
      </p>
    </div>

    <% if (game.challenges && game.challenges.length) { %>
      <% game.challenges.forEach(function(challenge) { %>
        <div >
          <h2>
            <a href="/challenges/<%= challenge.id %>">
              <%= challenge.name %>
            </a>
          </h2>

          <p>
            Votes: <span id="votes-<%= challenge.id %>"><%= challenge.dataValues.voteCount %></span>
          </p>

          <!-- Bouton Like -->
          <button  data-id="<%= challenge.id %>">J'aime</button>
        </div>
      <% }); %>
    <% } else { %>
      <p>Aucun challenge disponible.</p>
    <% } %>

    <a href='/' >Accueil</a>
  </section>
</main>

<%- include('partials/footer') %>

<!-- Script pour gérer le Like -->
<script src="/js/like.js"></script>
