<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>

<main class="mychallenges-main">
  <div>
    <section class="profile-section">
      <h1><%= user.username %></h1>
      <img src="<%= session.user.picture %>" alt="avatar" />

      <h2>Réseaux sociaux</h2>
      <div class="profile-section__socials">
        <% const socials=[ { url: user.twitch_url, icon: 'fa-twitch' }, { url: user.youtube_url, icon: 'fa-youtube' }, { url: user.discord_url, icon: 'fa-discord' } ]; socials.forEach(social=> { if (social.url) { %>
          <a href="<%= social.url %>" target="_blank">
            <i class="fa-brands <%= social.icon %>"></i>
          </a>
        <% } }); %>
      </div>
    </section>

    <section class="challenges-section">
      <h2>Mes challenges</h2>
      <ul class="challenges-section__mychallenges-list">
        <% if (listChallenges && listChallenges.length > 0) { %>
          <% listChallenges.forEach(challenge => { %>
            <li>
              <article class="challenges-section__mychallenges-card">
                <h3><%= challenge.name %></h3>
                <p>Jeu : <%= challenge.game.name %></p>
                <a href="/challenges/<%= challenge.id %>" target="_blank" class="myButton-form">Voir le challenge</a>
              </article>
            </li>
          <% }) %>
        <% } else { %>
          <p style="text-align:center; margin-top:2rem;">Aucun challenge pour le moment 😢</p>
        <% } %>
      </ul>
    </section>
  </div>
  
      <div class="pagination">
        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
          <% // Flèche précédente %>
          <% if (page > 1) { %>
            <a href="/mychallenges?page=<%= page - 1 %>" class="pagination__a">&laquo;</a>
          <% } %>

          <% // Page précédente %>
          <% if (page > 1) { %>
            <a href="/mychallenges?page=<%= page - 1 %>" class="pagination__a"><%= page - 1 %></a>
          <% } %>

          <% // Page courante %>
          <span class="pagination__span"><%= page %></span>

          <% // Page suivante %>
          <% if (page < totalPages) { %>
            <a href="/mychallenges?page=<%= page + 1 %>" class="pagination__a"><%= page + 1 %></a>
          <% } %>

          <% // Flèche suivante %>
          <% if (page < totalPages) { %>
            <a href="/mychallenges?page=<%= page + 1 %>" class="pagination__a">&raquo;</a>
          <% } %>
        <% } %>
      </div>

    </main>

<%- include('partials/footer.ejs') %>