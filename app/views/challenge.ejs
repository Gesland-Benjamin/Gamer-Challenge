<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>

<body>
  <div class="challenge-container">
      <!-- Image du challenge -->
      <div class="challenge-image">
        <img src="<%= challenge.game.picture %>" alt="<%= challenge.name %>" width="250">
      </div>

      <!-- Titre et description -->
      <div class="challenge-title"><%= challenge.name %></div>
      <div class="challenge-description"><%= challenge.description %></div>

      <!-- Date -->
      <div class="challenge-meta">
        <%= new Date(challenge.release_date).toLocaleDateString() %>
      </div>

      <!-- Bouton J'aime -->
      <p>
        Votes: <span id="votes-<%= challenge.id %>"><%= challenge.dataValues.voteCount || 0 %></span>
      </p>
      <button class="like-btn" data-id="<%= challenge.id %>">J'aime</button>

      <!-- Lien pour uploader une vidéo -->
      <a href="/challenges/<%= challenge.id %>/upload/video" class="upload-link">Uploader une vidéo</a>

      <!-- Liste des vidéos -->
      <div class="videos">
        <% if (challenge.videos && challenge.videos.length > 0) { %>
          <% challenge.videos.forEach(function(video) { %>
            <div class="video-entry">
              <p><strong><%= video.user.username %> :</strong> <%= video.title %></p>
              <iframe width="560" height="315" src="<%= video.url %>" frameborder="0" allowfullscreen></iframe>
            </div>
          <% }) %>
        <% } else { %>
          <div>Aucune vidéo pour ce challenge.</div>
        <% } %>
      </div>

      <% if (user && (user.id === challenge.user_id || user.role === 'admin')) { %>
        <form action="/challenges/<%= challenge.id %>/delete" method="POST">
          <button class="button-delete" type="submit">Supprimer</button>
        </form>
        <a class="button" href="/challenges/<%= challenge.id %>/edit">Modifier</a>
      <% } %>
      <a class = "button" href="/games/<%=challenge.game.id%>">Retour au jeu</a>

      <!-- Pagination -->
      <div class="pagination">
        <% if (totalPages > 1) { %>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <% if (i === page) { %>
              <span><%= i %></span>
            <% } else { %>
              <a href="/challenge-pagination?page=<%= i %>"><%= i %></a>
            <% } %>
          <% } %>
        <% } %>
      </div>

</body>

<%- include('partials/footer.ejs') %>
<!-- Script pour gérer le Like -->
<script src="/js/like.js"></script>
