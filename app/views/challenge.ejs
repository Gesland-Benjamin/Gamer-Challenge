<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>

<body>
  <div class="challenge-container">
    <div class="challenge-image">
      <img src="<%= challenge.picture %>" alt="<%= challenge.name %>" width="250">
    </div>
    <div class="challenge-title"><%= challenge.name %></div>

    <div class="challenge-description">
      <%= challenge.description %>
    </div>

    <div class="challenge-meta">
      <%= new Date(challenge.release_date).toLocaleDateString() %>
      <% if (challenge.user) { %> - <%= challenge.user.username %> <% } %>
      <span>♥</span>
    </div>

    <div class="videos">
      <% if (challenge.participations && challenge.participations.length > 0) { %>
        <% challenge.participations.forEach(function(participation) { %>
          <a href="<%= video.url %>">
            <img src="/images/youtube-logo.png" alt="YouTube">
          </a>
        <% }) %>
      <% } else { %>
        <div>Aucune vidéo pour ce challenge.</div>
      <% } %>
    </div>

    <div class="pagination">
      &lt;123&gt;
    </div>
  </div>
</body>
<%- include('partials/footer.ejs') %>

