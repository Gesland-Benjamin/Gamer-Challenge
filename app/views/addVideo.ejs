<%- include('./partials/header') %>
<%- include('./partials/aside_nav') %>

<main>
  <section class="add_form">
    <div class="forms-container">
      <form method="POST" class="form_register">
        <legend class="form-legend">Ajouter une vidéo pour <%= challenge.name %></legend>
        <div class="form_content_container">
          <input type="text" placeholder="Titre de la vidéo" name="title" class="input" required>
        </div>
        <div class="form_content_container">
          <input type="text" placeholder="URL de la vidéo" name="url" class="input" required>
        </div>
        <button type="submit" class="myButton-form">Valider</button>
        <a href="/" class="myButton-form">Retour à l'accueil</a>
      </form>
      
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
