<%- include('partials/header') %>
<%- include('partials/aside_nav') %>

<main class="search-page" aria-label="section de recherche">
  <h1 class="search-title">Résultats pour "<%= query %>"</h1>

  <% if (!results || (Array.isArray(results) && results.length === 0) || (typeof results === 'object' && Object.keys(results).length === 0)) { %>
    <p class="no-results">Aucun résultat trouvé.</p>
  <% } else { %>
    <% if (type === 'games') { %>
      <h2 class="search-section-title" aria-label="Recherche un jeu">Jeux</h2>
      <ul class="search-card">
        <% results.forEach(game => { %>
          <li class="search-item"><a href="/games/<%= game.id %>"><%= game.name %></a></li>
        <% }) %>
      </ul>
    <% } else if (type === 'challenges') { %>
      <h2 class="search-section-title" aria-label="Recherche un challenge">Challenges</h2>
      <ul class="search-card">
        <% results.forEach(challenge => { %>
          <li class="search-item"><a href="/challenges/<%= challenge.id %>"><%= challenge.name %></a></li>
        <% }) %>
      </ul>
    <% } else if (type === 'users') { %>
      <h2 class="search-section-title" aria-label="Recherche un joueur">Joueurs</h2>
      <ul class="search-card">
        <% results.forEach(user => { %>
          <li class="search-item"><a href="/profile/<%= user.id %>"><%= user.username %></a></li>
        <% }) %>
      </ul>
    <% } %>
  <% } %>
</main>

<%- include('./partials/footer') %>
