<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GamerChallenge</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Courgette&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100..900;1,100..900&family=Tinos:ital,wght@0,400;0,700;1,400;1,700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
</head>

<body>
    <% if (typeof session !== 'undefined' && session.flashMessage) { %>
    <div class="flash-messages">
        <div class="flash-message <%= session.flashMessage.type %>">
          <p><%= session.flashMessage.message %></p>
        </div>
        <% session.flashMessage = null; %> 
    </div>
    <% } %>
    <!-- Header -->
    <header>
      <div class="header__logo">
        <a href="/"><img class="logo__gc" src="/logos/manette.png" alt=""></a>
      </div>

      <nav class="header-nav" aria-label="navigation principale">
        <% if (session && session.user) { %>
          <div class="header-nav__user-info">
            <a href="/mychallenges" class="user-link">
              <img src="<%= session.user.picture %>" alt="avatar" width="30" height="30" style="border-radius: 50%" />
            </a>
            <form method="post" action="/logout">
              <button class="header-nav__logout-btn">Déconnexion</button>
            </form>
          </div>
          <% } else { %>
            <a href="/register" class="header-nav__hightlight">Inscription / Connexion</a>
            <a href="/register" class="header-nav__icon-login"><i class="fa-solid fa-user-plus"></i></a>
            <% } %>
              <% if (session && session.user && session.user.role==='admin' ) { %>
                <a href="/admin">Dashboard</a>
                <% } %>

                  <a href="/games">Jeux</a>
                  <a href="/challenges">Challenges</a>
                  <a href="/ladder">Classement</a>

                  <!-- BARRE DE RECHERCHE -->
                  <form action="/search" method="GET" class="search-form" aria-label="Barre de recherche des jeux, challenges et utilisateurs">
                    <input type="text" name="q" placeholder="Rechercher..." class="search-form__input" required />
                    <select name="type" class="search-form__select">
                      <option value="games">Jeux</option>
                      <option value="challenges">Challenges</option>
                      <option value="users">Joueurs</option>
                    </select>
                    <button type="submit" class="search-form__btn"><i class="fa-solid fa-magnifying-glass"></i></button>
                  </form>
      </nav>

      <!-- Burger Menu dans le header (desktop) -->
      <div class="header__burger" id="header-burger">
        <div class="header__burger-line"></div>
        <div class="header__burger-line"></div>
        <div class="header__burger-line"></div>
      </div>
    </header>
