<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GamerChallenge</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/home.css">
</head>

<body>
    <!-- Header -->
    <header>
        <nav class="header__menu">
            <a href="/games">Jeux</a>
            <a href="/challenges">Challenges</a>
            <a href="/ladder">Classement</a>
            <% if (session && session.user) { %>
                <a href="/">
                    <img src="<%= session.user.avatar %>" alt="avatar" width="30" height="30" style="border-radius:50%">
                    Mon compte
                </a>
                <form method="post" action="/logout">
                    
                            <button
                                class="inline-flex items-center rounded-lg bg-primary px-3 py-1.5 text-white text-xs sm:text-sm lg:text-xl font-medium hover:bg-primary/90">
                                Se déconnecter
                            </button>
                        </form>
                <% } else { %>
                    <a href="/register">Inscription / Connexion</a>
                    <% } %>
                        
        </nav>
    </header>

