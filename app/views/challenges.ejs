<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>

<main>
  <div class="games__top-title-wrapper">
    <span class="games__top-title">CHALLENGES</span>
    <div class="games__top-bar"></div>
  </div>

  <ul class="list">
    <% if (listChallenges && listChallenges.length > 0) { %>
      <% listChallenges.forEach(function(challenge) { %>
        <li class="list__game">
          <a href="/challenges/<%= challenge.id %>">
            <img class="game-cover" src="<%= challenge.game.picture %>" alt="<%= challenge.name %>" width="250">
            <h2 id="challenge<%= challenge.id %>" class="game-name"><%= challenge.name %></h2>
          </a>
        </li>
      <% }) %>
    <% } else { %>
      <li class="list__error-message">Aucun challenge disponible.</li>
    <% } %>
  </ul>

   <div class="pagination">
    <% if (totalPages > 1) { %>
      <% // Flèche précédente %>
      <% if (page > 1) { %>
        <a href="/challenges?page=<%= page - 1 %>" class="pagination__a">&laquo;</a>
      <% } %>

      <% // Page précédente %>
      <% if (page > 1) { %>
        <a href="/challenges?page=<%= page - 1 %>" class="pagination__a"><%= page - 1 %></a>
      <% } %>

      <% // Page courante %>
      <span class="pagination__span"><%= page %></span>

      <% // Page suivante %>
      <% if (page < totalPages) { %>
        <a href="/challenges?page=<%= page + 1 %>" class="pagination__a"><%= page + 1 %></a>
      <% } %>

      <% // Flèche suivante %>
      <% if (page < totalPages) { %>
        <a href="/challenges?page=<%= page + 1 %>" class="pagination__a">&raquo;</a>
      <% } %>
    <% } %>
  </div>
</main>

<%- include('partials/aside_nav.ejs') %>
<%- include('partials/footer.ejs') %>