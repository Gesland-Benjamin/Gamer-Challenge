<%- include('partials/header.ejs') %>
<%- include('partials/aside_nav.ejs') %>
<body>
  <div >
    <div >CHALLENGES</div>

    <div >
      <% if (listChallenges && listChallenges.length > 0) { %>
        <% listChallenges.forEach(function(challenge) { %>
          <div >
            <img src="<%= challenge.picture %>" alt="<%= challenge.name %>">
            <div ><%= challenge.name %></div>
            <div ><%= challenge.description %></div>
            <div >Date de sortie : <%= challenge.release_date.toLocaleDateString() %></div>
            <a href="/challenges/<%= challenge.id %>">Voir le challenge</a>
          </div>
        <% }) %>
      <% } else { %>
        <div>Aucun challenge trouvé.</div>
      <% } %>
    </div>

    <div >
  <% if (totalPages > 1) { %>
    <% for (let i = 1; i <= totalPages; i++) { %>
      <% if (i === page) { %>
        <span><%= i %></span>
      <% } else { %>
        <a href="/challenges?page=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>
  <% } %>
</div>
</body>

<%- include('partials/aside_nav.ejs') %>
<%- include('partials/footer.ejs') %>