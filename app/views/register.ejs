<%- include('./partials/header') %> <%- include('./partials/aside_nav') %>

<section class="register_login">

    <div class="forms_container">
        <form action="/register" method="post" class="form_register">
            <legend>Inscription</legend>
            <fieldset>
                <div class="form_content_container">
                    <input type="text" placeholder="PSEUDO" name="username" class="form_input">
                </div>
                <div class="form_content_container">
                    <input type="mail" placeholder="MAIL@MAIL.COM" name="mail" class="form_input">
                </div>
                <div class="form_content_container">
                    <input type="password" placeholder="MOT DE PASSE" name="password" class="form_input">
                </div>
                <div>
                    <input type="checkbox" name="privacy" value="true" required>J'ai pris connaissance et j'accepte la politique de confidentialité
                </div>
                <button type="submit" class="btn_submit">Valider</button>
            </fieldset>
        </form>

        <form action="/login" method="post">
            <legend>Connexion</legend>
            <fieldset>
                <div class="form_content_container">
                    <input value="bob" type="text" placeholder="PSEUDO OU MAIL@MAIL.COM" name="login" class="form_input">
                </div>
                <div class="form_content_container">
                    <input value="password2" type="password" placeholder="MOT DE PASSE" name="password" class="form_input">
                </div>
                <button type="submit" class="btn_submit">Valider</button>
            </fieldset>
        </form>
    </div>
    <div>
      <h2 class="form-legend">Connexion</h2>
      <form action="/login" method="post">
        <div>
          <input
            class="input"
            value="alice"
            type="text"
            placeholder="PSEUDO OU MAIL@MAIL.COM"
            name="login"
          />
        </div>
        <div class="form_content_container">
          <input
            class="input"
            value="password1"
            type="password"
            placeholder="MOT DE PASSE"
            name="password"
          />
        </div>
        <button class="myButton-form" type="submit">Valider</button>
      </form>
    </div>
  </div>
  <div class="center-btn">
    <a class="myButton" href="/">Retour à l'accueil</a>
  </div>
</section>

<%- include('./partials/footer') %>
