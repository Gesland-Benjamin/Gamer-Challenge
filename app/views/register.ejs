<%- include('./partials/header') %>
<%- include('./partials/aside_nav') %>

<section >

    <div>
        <form action="/register" method="post" >
            <legend>Inscription</legend>
            <fieldset>
                <div >
                    <input type="text" placeholder="PSEUDO" name="username" >
                </div>
                <div class="form_content_container">
                    <input type="mail" placeholder="MAIL@MAIL.COM" name="mail" >
                </div>
                <div class="form_content_container">
                    <input type="password" placeholder="MOT DE PASSE" name="password" >
                </div>
                <div>
                    <input type="checkbox" name="privacy" value="true" required>J'ai pris connaissance et j'accepte la politique de confidentialité
                </div>
                <button type="submit" >Valider</button>
            </fieldset>
        </form>

        <form action="/login" method="post">
            <legend>Connexion</legend>
            <fieldset>
                <div >
                    <input value="alice" type="text" placeholder="PSEUDO OU MAIL@MAIL.COM" name="login" >
                </div>
                <div class="form_content_container">
                    <input value="password1" type="password" placeholder="MOT DE PASSE" name="password" >
                </div>
                <button type="submit" >Valider</button>
            </fieldset>
        </form>
    </div>

    <a href="/">Retour à l'accueil</a>

</section>

<%- include('./partials/footer') %>