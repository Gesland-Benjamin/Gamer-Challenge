<%- include('./partials/header') %> 
<%- include('./partials/aside_nav') %>

<main class="add-challenge">

  <div class="add-challenge__header">
    <span class="add-challenge__title">AJOUTER UN CHALLENGE</span>
    <div class="add-challenge__title-bar"></div>
  </div>

  <!-- FORMULAIRE -->
  <section class="add-challenge__form-section">

    <div class="add-challenge__form-container">
      <form method="POST" class="add-challenge__form" action="/challenges/<%= game.id %>/addChallenge">
        <legend class="add-challenge__legend">Ajouter un challenge sur <%= game.name %></legend>

        <div class="add-challenge__input-group">
          <input type="text" placeholder="Titre du challenge" name="name" class="add-challenge__input">
        </div>

        <div class="add-challenge__input-group">
          <textarea placeholder="Description" name="description" class="add-challenge__input"></textarea>
        </div>

        <button class="add-challenge__submit-btn" type="submit">Valider</button>
      </form>
    </div>

    <a href="/" class="add-challenge__return-btn">Retour à l'accueil</a>
  </section>
</main>

<%- include('./partials/footer') %>
