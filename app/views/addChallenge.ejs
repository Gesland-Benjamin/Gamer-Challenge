<%- include('./partials/header') %> 
<%- include('./partials/aside_nav') %>

<main class="addChallenge__main">

  <div class="games__top-title-wrapper">
    <span class="games__top-title">AJOUTER UN CHALLENGE</span>
    <div class="games__top-bar"></div>
  </div>

  <!-- FORM -->
  <section class="addChallenge_form">

    <div class="form__container">
      <form method="POST" class="form_register" action="/challenges/<%= game.id %>/addChallenge">
      <legend class="form__legend">Ajouter un challenge sur <%= game.name %></legend>

        <div class="form_content_container">
          <input type="text" placeholder="Titre du challenge" name="name" class="form__input">
        </div>

        <div class="form_content_container">
          <textarea placeholder="Description" name="description" class="form__input"></textarea>
        </div>

        <div class="div__btn">
          <button type="submit" class="btn__submit">Valider</button>
        </div>
      </form>
    </div>

    <a href="/" class="back_link">Retour à l'accueil</a>
  </section>
</main>

<%- include('./partials/footer') %>
