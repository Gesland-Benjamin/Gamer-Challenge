
<%- include('partials/header.ejs') %>

<!-- Contenu principal -->
<main>
  <div class="main__container-top">
    <h1>LOGO GAMER CHALLENGES</h1>
    <h2>Vous êtes prêts ? A vous de jouer !</h2>

    <section class="sidenav">
      <svg class="menu-burger-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M4 6a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1m0 6a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1m1 5a1 1 0 1 0 0 2h14a1 1 0 1 0 0-2z"/></svg>
      <%- include('partials/aside_nav') %>
    </section>
  </div>

  <section class="top-challenges-section">

    <div class="top-title-wrapper">
      <span class="top-title">Top 3 Challenges</span>
      <div class="top-bar"></div>
    </div>

    <div class="challenges-list">

      <% challenges.forEach(function(challenge) { %>

        <div class="challenge">
          <h2><%= challenge.name %></h2>
          <p>Votes: <%= challenge.dataValues.voteCount %></p>
        </div>
          
      <% }); %>

      <button class="myButton">VOIR PLUS</button>
    </div>
  </section>
</main>


<%- include('partials/footer.ejs') %>
